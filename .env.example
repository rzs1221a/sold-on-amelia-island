# Copy to Netlify → Project configuration → Environment variables.
# NEVER commit real values. Everything here is server-side only — none of it is
# exposed to the browser.

# --- BoldTrail Lead Dropbox -------------------------------------------------
# Agent-scoped ingestion addresses from BHHS Connect:
#   Lead Engine Tools & Features → Web & IDX → Leads Sync
# Switch the "Agent" selector to each agent to get THEIR address.
#
# SECURITY: these are unauthenticated write credentials. Anyone holding one can
# inject contacts straight into the live CRM — there is no sender verification,
# no key, no signature. Treat them like passwords. If one leaks, rotate it via
# Lead Engine → Lead Dropbox.
# The function ships with Kelly's and Will's current addresses built in as
# defaults, so these are only needed to OVERRIDE (e.g. after a rotation).
BOLDTRAIL_DROPBOX_EMAIL_BUYER=leads+REPLACE-ME-kelly@kvcore.com
BOLDTRAIL_DROPBOX_EMAIL_SELLER=leads+REPLACE-ME-will@kvcore.com

# Optional single-address fallback, used for either side if the specific
# variable above is unset.
# BOLDTRAIL_DROPBOX_EMAIL=

# --- Transport --------------------------------------------------------------
# Resend API key (https://resend.com → API Keys).
RESEND_API_KEY=re_REPLACE_ME

# Verified sender. The domain must be verified in Resend before it can send.
LEAD_FROM_EMAIL=leads@soldonameliaisland.com
